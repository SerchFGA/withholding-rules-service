{
  "permissions": {
    "allow": [
      "Bash(python .claude/skills/en-curso/en_curso.py *)",
      "PowerShell(python .claude/skills/en-curso/en_curso.py *)",
      "Bash(python .claude/hooks/verificar.py*)",
      "PowerShell(python .claude/hooks/verificar.py*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/skills/en-curso/en_curso.py\" estado --todos",
            "timeout": 10,
            "statusMessage": "Leyendo EN-CURSO.md"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar.py\" --hook",
            "timeout": 30,
            "statusMessage": "Verificando INDICE.md"
          }
        ]
      }
    ]
  }
}
